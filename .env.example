# PostgreSQL connection used by the application and migrations.
DATABASE_URL=postgresql://jobsearch:jobsearch@localhost:5432/jobsearch

# HTTP client behaviour for API-based collectors.
HTTP_TIMEOUT_SECONDS=20
HTTP_USER_AGENT=job-search-automation/0.1 (+https://github.com/mravaneesh/job-search-automation)

# Politeness: minimum delay (seconds) between requests to the same source.
RATE_LIMIT_DELAY_SECONDS=1.0

# Playwright collectors (LinkedIn/Indeed/Naukri/Wellfound).
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_NAV_TIMEOUT_MS=30000

# Log level: DEBUG/INFO/WARNING/ERROR
LOG_LEVEL=INFO

# --- Phase 2: optional LLM scoring ---
# Only needed if config/scoring.yaml has use_llm: true.
ANTHROPIC_API_KEY=

# --- Phase 3: notifications (all optional; channels skip when unset) ---
# Telegram bot (create via @BotFather; chat id from @userinfobot or getUpdates).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email via SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=
EMAIL_TO=          # comma-separated recipients

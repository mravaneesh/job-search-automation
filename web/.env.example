# Copy to .env.local and fill in. The Python pipeline must have populated this DB.
DATABASE_URL=postgresql://jobsearch:jobsearch@127.0.0.1:5432/jobsearch

# Auth.js session signing secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Google OAuth — create at https://console.cloud.google.com/apis/credentials
#   Authorized JavaScript origin:  http://localhost:3000
#   Authorized redirect URI:       http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Local-only: allow a one-click dev login without Google. NEVER set in production.
DEV_LOGIN=1
